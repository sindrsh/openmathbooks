\opr{opgalgfakt}
\abc{
\item Vi har allerede funnet at $x^2+6x-7=(x+3)^2-16$. Ved å bruke 3. kvadratsetning, får vi at
\begin{align*}
	(x+3)^2-16 &= (x+3)-4^2 \\
	&=(x+3+4)(x+3-7) \\
	&=(x+7)(x-1)
\end{align*}
\item Vi har allerede funnet at $x^2-8x-20=(x-4)^2-36$. Ved å bruke 3. kvadratsetning, får vi at
\begin{align*}
	(x-4)^2-36 &= (x-4)^2-6^2 \\
	&= (x-4+6)(x-4-6) \\
	&= (x+2)(x-10)
\end{align*}
}

