		\frac{1}{\sqrt{a}+\sqrt{b}}&= \frac{1}{\sqrt{a}+\sqrt{b}}\cdot\frac{\sqrt{a}-\sqrt{b}}{\sqrt{a}-\sqrt{b}} \br
		&=\frac{\sqrt{a}-\sqrt{b}}{(\sqrt{a})^2-(\sqrt{b})^2} \br
		&=\frac{\sqrt{a}-\sqrt{b}}{a-b} \\
	\end{align*}
}

